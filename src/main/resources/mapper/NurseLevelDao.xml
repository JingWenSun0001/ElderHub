<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.it.elderhub.dao.NurseLevelDao">

    <resultMap type="com.it.elderhub.entity.NurseLevel" id="NurseLevelMap">
        <result property="id" column="id" jdbcType="INTEGER"/>
        <result property="levelName" column="level_name" jdbcType="VARCHAR"/>
        <result property="levelStatus" column="level_status" jdbcType="INTEGER"/>
        <result property="isDeleted" column="is_deleted" jdbcType="INTEGER"/>
    </resultMap>

    <!-- 批量插入 -->
    <insert id="insertBatch" keyProperty="id" useGeneratedKeys="true">
        insert into elderhub.nurse_level(level_name, level_status, is_deleted)
        values
        <foreach collection="entities" item="entity" separator=",">
        (#{entity.levelName}, #{entity.levelStatus}, #{entity.isDeleted})
        </foreach>
    </insert>
    <!-- 批量插入或按主键更新 -->
    <insert id="insertOrUpdateBatch" keyProperty="id" useGeneratedKeys="true">
        insert into elderhub.nurse_level(level_name, level_status, is_deleted)
        values
        <foreach collection="entities" item="entity" separator=",">
            (#{entity.levelName}, #{entity.levelStatus}, #{entity.isDeleted})
        </foreach>
        on duplicate key update
level_name = values(level_name) , level_status = values(level_status) , is_deleted = values(is_deleted)     </insert>

</mapper>

