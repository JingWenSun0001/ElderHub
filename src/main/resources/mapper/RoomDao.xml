<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.it.elderhub.dao.RoomDao">

    <resultMap type="com.it.elderhub.entity.Room" id="RoomMap">
        <result property="id" column="id" jdbcType="INTEGER"/>
        <result property="roomFloor" column="room_floor" jdbcType="VARCHAR"/>
        <result property="roomNo" column="room_no" jdbcType="INTEGER"/>
    </resultMap>

    <!-- 批量插入 -->
    <insert id="insertBatch" keyProperty="id" useGeneratedKeys="true">
        insert into elderhub.room(room_floor, room_no)
        values
        <foreach collection="entities" item="entity" separator=",">
        (#{entity.roomFloor}, #{entity.roomNo})
        </foreach>
    </insert>
    <!-- 批量插入或按主键更新 -->
    <insert id="insertOrUpdateBatch" keyProperty="id" useGeneratedKeys="true">
        insert into elderhub.room(room_floor, room_no)
        values
        <foreach collection="entities" item="entity" separator=",">
            (#{entity.roomFloor}, #{entity.roomNo})
        </foreach>
        on duplicate key update
room_floor = values(room_floor) , room_no = values(room_no)     </insert>

</mapper>

